rules_version = '2';

// Regole di sicurezza di Last Time.
//
// Con l'auth anonima chiunque puo' ottenere un'identita' sul progetto: queste regole
// sono l'unica cosa che separa i dati di un gruppo dal resto del mondo. Il principio e'
// uno solo: si legge e si scrive dentro un gruppo solo se si e' membri di quel gruppo,
// e si diventa membri solo presentando un invito valido.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isCreator(groupId) {
      return signedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
    }

    function validInvite(groupId, code) {
      let inv = get(/databases/$(database)/documents/invites/$(code)).data;
      return inv.groupId == groupId && inv.expiresMs > request.time.toMillis();
    }

    // Inviti. Si leggono solo conoscendo il codice esatto: "list" resta negato, cosi'
    // nessuno puo' scorrere gli inviti in giro per trovarne uno valido.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn(); // serve a marcarlo usato
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    match /groups/{groupId} {
      // Niente "list": il client conosce sempre l'id dei suoi gruppi, non li cerca.
      allow get: if isMember(groupId);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMember(groupId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(groupId);
        // Entrare nel gruppo: solo per se stessi, e in uno di due modi. O hai appena
        // creato il gruppo — e allora il primo membro sei tu, senza invitarti da solo —
        // oppure presenti un invito valido per questo gruppo. E' l'unico punto in cui
        // chi non e' ancora membro puo' scrivere qualcosa.
        allow create: if signedIn()
                      && uid == request.auth.uid
                      && (
                           isCreator(groupId)
                           || validInvite(groupId, request.resource.data.code)
                         );
        allow update, delete: if signedIn() && uid == request.auth.uid;
      }

      match /counters/{counterUuid} {
        allow read, write: if isMember(groupId);
      }

      match /rounds/{roundUuid} {
        allow read, create: if isMember(groupId);
        // I round sono append-only, con un'unica eccezione stretta: l'endMs dell'ULTIMO
        // round di un contatore si puo' correggere (un errore battuto a caldo sull'orario
        // di un riavvio), da chiunque sia nel gruppo, non solo da chi l'ha scritto. Tutto
        // il resto — quale round e' capitato, chi, quando e' cominciato, ogni round piu'
        // vecchio dell'ultimo — resta bloccato: nessuno puo' riscrivere la storia altrui.
        allow update: if isMember(groupId)
          && get(/databases/$(database)/documents/groups/$(groupId)/counters/$(resource.data.counterUuid))
               .data.get('lastRoundUuid', '') == roundUuid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endMs'])
          && request.resource.data.endMs >= resource.data.startMs
          && request.resource.data.endMs <= request.time.toMillis();
        allow delete: if false;
      }
    }
  }
}
